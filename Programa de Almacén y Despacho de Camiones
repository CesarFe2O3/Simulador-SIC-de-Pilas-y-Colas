from colorama import init, Fore, Back, Style
import os

init(autoreset=True)

class Stack:
    def __init__(self):
        self.stack = []
    def is_empty(self):
        return True if len(self.stack)==0 else False
    def push(self, item):
        self.stack.append(item)
    def pop(self):
        return None if self.is_empty() else self.stack.pop()
    def peek(self):
        return None if self.is_empty() else self.stack[-1]

class Queue:
    def __init__(self):
        self.queue = []
    def is_empty(self):
        return True if len(self.queue)==0 else False
    def enqueue(self,item):
        self.queue.append(item)
    def dequeue(self):
        return None if self.is_empty() else self.queue.pop(0)
    def size(self):
        return len(self.queue)


def programa_transporte_cajas():
   
    
    cajas = Stack()
    lista_cajas = []  # Almacenará diccionarios con la info de cada caja (Base -> Cima)

    camiones = Queue()
    lista_camiones = []
    despacho_cajas = []



    def si_no(respuesta):
        if respuesta in ['si','s','yes','y','1','Si','S']:
            return True
        if respuesta in ['no','not','n','0','No','Not','N']:
            return False

    def limpiar_pantalla():
        os.system('cls' if os.name == 'nt' else 'clear')

    def almacenar_cajas_pila():
        limpiar_pantalla()
        print(Fore.CYAN +'--- ALMACÉN DE CAJAS ---')
        print(Fore.GREEN +'El nombre de la caja puede ser cualquiera (ej. Televisor, Caja-10, Ropa).')
        while True:
            nombre_caja = input('Ingresa el nombre de la caja: ').strip(" ./,:;'[]!@#$%^&*()_+=<>").capitalize()
            if not nombre_caja:
                print(Fore.RED + 'El nombre no puede estar vacío.')
                continue
            if  not nombre_caja.startswith('Caja-'):
                nombre_caja = 'Caja-' + nombre_caja
            destino_camion = input('Ingresa el nombre del camión al que pertenece (ej. Camion-A o solo A): ').strip(" ./,:;'[]!@#$%^&*()_+=<>").capitalize()
            if not destino_camion:
                print(Fore.RED + 'El nombre no puede estar vacío.')
                continue
            if not destino_camion.startswith('Camion-'):
                destino_camion = 'Camion-' + destino_camion

            # Verificamos si ya existe una caja con ese mismo nombre exacto
            if any(c['nombre'] == nombre_caja for c in lista_cajas):
                print(Fore.RED + 'Ya existe una caja con ese nombre en el almacén. Usa otro nombre.')
                otra = input('Quieres almacenar otra caja? (Responde Si o No): ').strip()
                if si_no(otra) == True:
                    continue
                elif si_no(otra) == False:
                    limpiar_pantalla()
                    print(Fore.YELLOW + 'Cajas almacenadas con éxito.')
                    break
                

            caja_info = {'nombre': nombre_caja, 'camion': destino_camion}

            lista_cajas.append(caja_info)
            cajas.push(caja_info)
            print(Fore.YELLOW + f'La caja "{nombre_caja}" con destino al {destino_camion} ha sido apilada con éxito.')

            otra = input('Quieres almacenar otra caja? (Responde Si o No): ').strip()
            if si_no(otra) == True:
                continue
            elif si_no(otra) == False:
                limpiar_pantalla()
                print(Fore.YELLOW + 'Cajas almacenadas con éxito.')
                break
            else:
                limpiar_pantalla()
                print(Fore.RED + 'Error. Responde con Si o No')
                otra = input('Quieres almacenar otra caja? (Responde Si o No): ').strip()
    def camion_cola():
        limpiar_pantalla()
        print(Fore.CYAN + '--- LLEGADA DE CAMIONES ---')
        print(Fore.YELLOW + 'Ejemplo: J (para Camion-J)')
        while True:
            nombre_camion = input('Ingresa el nombre del camión: ').strip(" ./,:;'[]!@#$%^&*()_+=<>").capitalize()
            if not nombre_camion:
                print(Fore.RED + 'El nombre no puede estar vacío.')
                continue
            if not nombre_camion.startswith('Camion-'):
                            nombre_camion = 'Camion-' + nombre_camion
            

            if nombre_camion in lista_camiones:
                print(Fore.RED + 'Ya este camión está en cola. Enlista otro camión.')
                otra = input('Quieres enlistar otro camión? (Responde Si o No): ').strip()
                if si_no(otra)==True:
                    continue
                elif si_no(otra) == False:
                    limpiar_pantalla()
                    print(Fore.YELLOW + 'Camiones enlistados con éxito.')
                    break
                

            lista_camiones.append( nombre_camion)
            camiones.enqueue( nombre_camion)
            despacho_cajas.append([])
            print(Fore.YELLOW + f'El camión { nombre_camion} está en la fila.')

            otra = input('Quieres enlistar otro camión? (Responde Si o No): ').strip()
            if si_no(otra)==True:
                continue
            elif si_no(otra) == False:
                limpiar_pantalla()
                print(Fore.YELLOW + 'Camiones enlistados con éxito.')
                break
            else:
                print(Fore.RED + 'Error. Responde con Si o No')
                otra = input('Quieres enlistar otro camión? (Responde Si o No): ').strip()
                if si_no(otra)==True:
                    continue
                elif si_no(otra) == False:
                    limpiar_pantalla()
                    print(Fore.YELLOW + 'Camiones enlistados con éxito.')
                    break

    def retiro_cajas_pila():
        limpiar_pantalla()
        print(Fore.CYAN + '--- GUARDAR CAJAS EN CAMIONES ---')
        print(Fore.GREEN + 'Se evaluará si el camión correspondiente a la caja en la cima ya se encuentra en la fila.')
        
        while True:
            if cajas.is_empty():  
                limpiar_pantalla()   
                print(Fore.RED + 'No hay mas cajas en el almacén.')           
                break

            despachar = input('Quieres despachar la caja de la cima a su camión? (Responde Si o No): ').strip()
            if si_no(despachar) == True:
                caja_actual = cajas.peek() # Diccionario con 'nombre' y 'camion'
                camion_destino = caja_actual['camion']

                # Evaluamos si el camión destino está actualmente en la fila
                if camion_destino in lista_camiones:
                    caja_despachada = cajas.pop()
                    lista_cajas.remove(caja_despachada) # Sincronizamos la lista

                    idx = lista_camiones.index(camion_destino)
                    despacho_cajas[idx].append(caja_despachada['nombre'])
                    print(Fore.YELLOW + f'¡Éxito! La caja "{caja_despachada["nombre"]}" fue enviada a su camión: {camion_destino}')
                    if cajas.is_empty(): 
                        limpiar_pantalla()
                        print(Fore.YELLOW + f'¡Éxito! La caja "{caja_despachada["nombre"]}" fue enviada a su camión: {camion_destino}')    
                        print(Fore.RED + 'No hay mas cajas en el almacén.')           
                        break
                else:
                    print(Fore.RED + f'AVISO: El camión "{camion_destino}" (destino de la caja "{caja_actual["nombre"]}") AÚN NO HA LLEGADO a la fila.')
                    print(Fore.RED + 'Debe registrar o hacer llegar este camión a la cola antes de poder despacharle su caja.')

            elif si_no(despachar) == False:
                limpiar_pantalla()
                print(Fore.YELLOW + 'Operación de despacho de cajas finalizada.')
                break
            else:
                print(Fore.RED + 'Error. Responde con Si o No')

    def despacho_camion():
        limpiar_pantalla()
        print(Fore.CYAN + '--- DESPACHO DE CAMIONES ---')

        while True:
            despachar = input('Quieres despachar el camión al principio de la fila? (Responde Si o No): ').strip()
            if si_no(despachar) == True:
                if camiones.is_empty():
                    limpiar_pantalla()
                    print(Fore.RED + 'No hay camiones en cola para despachar.')
                    break
                else:
                    camion_enviado = camiones.dequeue()
                    lista_camiones.pop(0)
                    cajas_camion = despacho_cajas.pop(0)
                    print(Fore.YELLOW + f'Se ha enviado el camión {camion_enviado} y su cargamento era: {cajas_camion}')
                    if camiones.is_empty():
                        limpiar_pantalla()
                        print(Fore.YELLOW + f'Se ha enviado el camión {camion_enviado} y su cargamento era: {cajas_camion}')
                        print(Fore.YELLOW +'Despachos finalizados.')
                        print(Fore.RED + 'No hay camiones en cola para despachar.')
                        break
            elif si_no(despachar) == False:
                limpiar_pantalla()
                print(Fore.YELLOW +'Despachos finalizados.')
                if camiones.is_empty():
                    print(Fore.RED + 'No hay camiones en cola para despachar.')
                break
            else:
                print(Fore.RED + 'Error. Responde con Si o No')

    def estado_cajas_camiones():
        
            limpiar_pantalla()
            print(Fore.CYAN + '--- ESTADO DEL SISTEMA ---')
            print(Fore.YELLOW +'Cajas apiladas (Cima -> Base):')
            if not lista_cajas:
                print(Fore.YELLOW +'  [Almacén vacío]')
            else:
                for c in reversed(lista_cajas):
                    print(Fore.WHITE + f"  - Caja: '{c['nombre']}' (Destino: {c['camion']})")

            if not lista_camiones:
                print(Fore.YELLOW + 'Fila de camiones (Frente -> Fin):')
                print(Fore.YELLOW +'  [Cola vacía]')
            else:
                print(Fore.YELLOW + 'Fila de camiones (Frente -> Fin):')
                for c in lista_camiones:
                    print(c,'----->','Cargamento: ',  despacho_cajas[lista_camiones.index(c)])
                #print(Fore.YELLOW + 'Fila de camiones (Frente -> Fin):', lista_camiones)
            input(Fore.GREEN + Style.DIM +'Presione Enter para volver a la pantalla principal')
            limpiar_pantalla()
                
        
    limpiar_pantalla()
    while True:
        
        print(Fore.CYAN + "==================================================")
        print(Fore.CYAN + '          SISTEMA DE DESPACHO Y ALMACÉN')
        print(Fore.CYAN + "==================================================")
        print('1. Almacen de cajas (Apilar cajas)')
        print('2. Llegada de camion al almacen (Llega el camion a la fila)')
        print('3. Guardar cajas a transportar (Retirar caja de la cima)')
        print('4. Enviar camion (Despachar primer camion)')
        print('5. Ver estado del almacen y los camiones')
        print('6. Salir del programa')
        print(Fore.CYAN + '--------------------------------------------------')
        try:
            select = int(input(Fore.YELLOW +'Seleccione una opción (1-6): '))
            match select:
                case 1: almacenar_cajas_pila()
                case 2: camion_cola()
                case 3: retiro_cajas_pila()
                case 4: despacho_camion()
                case 5: estado_cajas_camiones()
                case 6:
                    limpiar_pantalla()
                    print(Fore.YELLOW + 'Gracias por utilizar el programa. Hasta luego!')
                    break
                case _:
                    limpiar_pantalla()
                    print(Fore.RED + 'Error. Esa opción no se encuentra dentro del programa.\n')

        except ValueError:
            limpiar_pantalla()
            print(Fore.RED +'Error. Ingrese un número válido que coincida con las opciones.\n')
            continue
        

programa_transporte_cajas()
